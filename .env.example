# Copy to .env.local. Docs: CLAUDE.md § "Media lives on R2".

# Cloudflare R2 upload creds — tooling/build-time only, the site never reads them.
# Keys: Cloudflare dashboard → R2 → Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vatti-web-prod

# Forms — /api/ewarranty. Runtime; on Vercel these are project env vars.
# Without the key the endpoint returns 503 and the form says so.
RESEND_API_KEY=

# Optional, both have working defaults — see README § Environment.
# EWARRANTY_TO=enquiry@vattimalaysia.com
# Resend only sends from a verified domain; use onboarding@resend.dev to test.
# EWARRANTY_FROM=VATTI eWarranty <ewarranty@vattimalaysia.com>

# Post-migration guard. Set to 1 once media is repointed at the CDN and
# `pnpm db:check` starts failing on any legacy WordPress URL in the DB.
# MEDIA_MIGRATED=1
